# App
VITE_APP_TITLE=".Chat"
# Public origin, used for absolute Open Graph / Twitter card URLs
VITE_APP_URL=https://chat.abhinab.tech

# Database (Docker Postgres from docker-compose.yml)
# Host port is 5433 to avoid clashing with a local Postgres on 5432
DATABASE_URL="postgresql://chat:chat@localhost:5433/chat"

# Redis (Docker Redis from docker-compose.yml)
REDIS_URL="redis://localhost:6379"


# AI and web search (server-only; never prefix with VITE_)
GEMINI_API_KEY=
SERPER_API_KEY=

# Local embeddings (qwen3-embedding:0.6b, 1024 dimensions)
OLLAMA_BASE_URL=http://localhost:11434
# Optional server default; the chat model selector takes precedence
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI (server-only; ChatGPT Plus does not include API credits)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Logging: readable locally; production defaults to JSON. Set json for log collectors.
LOG_FORMAT=pretty
