# App
VITE_APP_TITLE=".Chat"
# Public origin, used for absolute Open Graph / Twitter card URLs
VITE_APP_URL=https://chat.abhinab.tech

# Convex
# Convex deployment name
CONVEX_DEPLOYMENT=
# Convex deployment URL (required)
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Database (Docker Postgres from docker-compose.yml)
# Host port is 5433 to avoid clashing with a local Postgres on 5432
DATABASE_URL="postgresql://chat:chat@localhost:5433/chat"

# Redis (Docker Redis from docker-compose.yml)
REDIS_URL="redis://localhost:6379"

# Better Auth
# Generate with: bunx --bun @better-auth/cli secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# OAuth providers (create apps in each provider console; see README/setup notes)
# Redirect URI for all: http://localhost:3000/api/auth/callback/<provider>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Email (Mailpit for local testing; see docker-compose.yml)
# Mailpit SMTP: localhost:1025, Web UI: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="no-reply@localhost"

# PostHog (optional)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# BYOK key encryption (optional)
# Falls back to BETTER_AUTH_SECRET when unset. Set a dedicated 32-byte secret
# in production to separate auth signing from provider-key encryption.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Server-to-Convex authentication (required for the agent)
# Generate once, then set the same value here and on your Convex deployment:
# npx convex env set AGENT_BRIDGE_SECRET (paste via stdin; never use VITE_ prefix)
AGENT_BRIDGE_SECRET=
# Gemini + web-search keys continue to come from encrypted per-user Settings.
# No separate memory API key is required.
